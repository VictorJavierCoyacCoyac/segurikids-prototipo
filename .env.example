# ─── SeguriKids · variables de entorno ────────────────────────────────────────
# Copia este archivo como `.env` antes de ejecutar el prototipo.

# Base de datos local del prototipo (SQLite).
# En producción se sustituiría por PostgreSQL:
#   DATABASE_URL="postgresql://usuario:password@host:5432/segurikids?schema=public"
DATABASE_URL="file:./dev.db"

# Secreto usado para firmar la cookie de sesión demo (HMAC-SHA256).
# DEMO: cámbialo por un valor aleatorio largo. En producción debe venir de un gestor de secretos.
SESSION_SECRET="cambia-este-secreto-de-demostracion-por-uno-aleatorio"

# Activa las credenciales visibles y el selector de usuarios demo en el login.
# Debe ser "false" en cualquier entorno que no sea una demostración.
NEXT_PUBLIC_DEMO_MODE="true"
